#!/bin/bash
# Pre-commit hook: run validation before committing
# Runs lint-staged, unit tests, and build to catch issues early

echo "=== Pre-commit checks ==="

# Step 1: Lint-staged (format and lint only staged files)
echo "→ Running lint-staged..."
npx lint-staged
if [ $? -ne 0 ]; then
  echo "✖ lint-staged failed. Fix the issues and try again."
  exit 1
fi
echo "✓ lint-staged passed"

# Step 2: Unit tests
echo "→ Running unit tests (vitest)..."
npx vitest run --reporter=verbose 2>&1 | tail -5
if [ $? -ne 0 ]; then
  echo "✖ Tests failed. Fix and try again."
  exit 1
fi
echo "✓ Unit tests passed"

# Step 3: Build (full Next.js production build)
echo "→ Running build..."
npm run build 2>&1 | tail -10
if [ $? -ne 0 ]; then
  echo "✖ Build failed. Fix and try again."
  exit 1
fi
echo "✓ Build passed"

echo "=== All pre-commit checks passed ==="